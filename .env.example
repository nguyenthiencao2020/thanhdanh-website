# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the site (used for SEO metadata / sitemap)
NEXT_PUBLIC_SITE_URL=https://thanhdanh.vercel.app

# Optional: protects /api/keep-alive (daily Vercel Cron that keeps the Supabase project awake).
# Any long random string; Vercel sends it automatically to the cron request.
CRON_SECRET=
